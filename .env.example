# The Model that runs every Review (required). Any model you've pulled into Ollama.
DIFFWISE_MODEL=qwen2.5-coder:7b

# Ollama's OpenAI-compatible endpoint (default shown).
# DIFFWISE_OLLAMA_URL=http://localhost:11434/v1

# Backend port (default 3001) and SQLite file (default ./diffwise.db).
# DIFFWISE_PORT=3001
# DIFFWISE_DB=./diffwise.db
