# Model Providers. Every Review runs on a Model you pick from those these providers offer.

# Ollama's OpenAI-compatible endpoint (default shown). Set it to an empty value to turn Ollama off.
# DIFFWISE_OLLAMA_URL=http://localhost:11434/v1

# Any OpenAI-compatible API. Turned on when either is set; the base URL defaults to OpenAI's.
# The API key stays on the backend: it never reaches the browser or the database.
# DIFFWISE_OPENAI_BASE_URL=https://api.openai.com/v1
# DIFFWISE_OPENAI_API_KEY=

# Backend port (default 3001) and SQLite file (default ./diffwise.db).
# DIFFWISE_PORT=3001
# DIFFWISE_DB=./diffwise.db
